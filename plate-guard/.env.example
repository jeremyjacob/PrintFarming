# Listener. Use 0.0.0.0 when Bambuddy runs inside Docker and must reach the host.
LISTEN_ADDR=127.0.0.1:8787

BAMBUDDY_URL=http://127.0.0.1:8000
BAMBUDDY_API_KEY=

OPENAI_API_KEY=replace-with-openai-project-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_DETAIL=high

# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-a-long-random-value

# Webhook timestamps without an offset are interpreted in this timezone.
BAMBUDDY_TIMEZONE=UTC
EVENT_MAX_AGE=5m

# Wait for ejection mechanics, then assess two fresh camera snapshots.
SNAPSHOT_DELAY=5s
WORKER_COUNT=4
AUTO_ENABLE_PLATE_CLEAR=true
DRY_RUN=false

BAMBUDDY_TIMEOUT=15s
OPENAI_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5m
