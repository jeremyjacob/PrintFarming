[Unit]
Description=Bambuddy OpenAI build plate guard
Documentation=https://github.com/jeremyjacob/PrintFarming
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=bambuddy-plate-guard
StateDirectoryMode=0700
EnvironmentFile=/etc/bambuddy-plate-guard/bambuddy-plate-guard.env
ExecStart=/usr/local/bin/bambuddy-plate-guard
Restart=on-failure
RestartSec=5s
TimeoutStopSec=330s
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
